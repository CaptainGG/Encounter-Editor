<Window x:Class="EncounterEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:EncounterEditor.App.ViewModels"
        xmlns:models="clr-namespace:EncounterEditor.Core.Models;assembly=EncounterEditor.Core"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1540"
        Height="960"
        MinWidth="1200"
        MinHeight="760"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:EncounterZoneViewModel}">
            <StackPanel>
                <TextBlock Text="Zone Inspector" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="Display Name" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding DisplayName, Mode=TwoWay}" />
                <TextBlock Text="Authored Name" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding Name, Mode=TwoWay}" />
                <TextBlock Text="Difficulty" Foreground="{StaticResource Brush.Muted}" />
                <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding Difficulty, Mode=TwoWay}" />
                <TextBlock Text="Faction" Foreground="{StaticResource Brush.Muted}" />
                <ComboBox ItemsSource="{Binding FactionOptions}" SelectedItem="{Binding Faction, Mode=TwoWay}" />
                <TextBlock Text="Recommended Player Level" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding RecommendedPlayerLevel, Mode=TwoWay}" />
                <TextBlock Text="X" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding X, Mode=TwoWay}" />
                <TextBlock Text="Y" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding Y, Mode=TwoWay}" />
                <TextBlock Text="Width" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding Width, Mode=TwoWay}" />
                <TextBlock Text="Height" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding Height, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SpawnPointViewModel}">
            <StackPanel>
                <TextBlock Text="Spawn Inspector" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="Display Name" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding DisplayName, Mode=TwoWay}" />
                <TextBlock Text="Archetype" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding Archetype, Mode=TwoWay}" />
                <TextBlock Text="Count" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding Count, Mode=TwoWay}" />
                <TextBlock Text="Delay (Seconds)" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding DelaySeconds, Mode=TwoWay}" />
                <TextBlock Text="Facing" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding FacingDegrees, Mode=TwoWay}" />
                <TextBlock Text="Linked Zone Id" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding LinkedZoneId, Mode=TwoWay}" />
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Brush.Muted}" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:PatrolRouteViewModel}">
            <StackPanel>
                <TextBlock Text="Patrol Inspector" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="Display Name" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding DisplayName, Mode=TwoWay}" />
                <TextBlock Text="Speed" Foreground="{StaticResource Brush.Muted}" />
                <TextBox Text="{Binding Speed, Mode=TwoWay}" />
                <CheckBox Content="Loop Route" IsChecked="{Binding Loop, Mode=TwoWay}" Margin="0,8,0,12" />
                <TextBlock Text="Patrol Points" Foreground="{StaticResource Brush.Muted}" />
                <Border Background="{StaticResource Brush.PanelAlt}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="10" CornerRadius="6">
                    <TextBlock Text="{Binding PointsSummary}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="New" Command="{Binding NewProjectCommand}" />
                    <Button Content="Open" Command="{Binding OpenProjectCommand}" />
                    <Button Content="Save" Command="{Binding SaveProjectCommand}" />
                    <Button Content="Save As" Command="{Binding SaveProjectAsCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="{Binding ProjectName}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="WPF level-design encounter editor sample for game tools interviews." Foreground="{StaticResource Brush.Muted}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#263545" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="16" Padding="12,4" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ZoomLabel}" />
                    </Border>
                    <Button Content="Reset View" Command="{Binding ResetViewportCommand}" Margin="0,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Validation" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding ValidationSummary}" Foreground="{StaticResource Brush.Muted}" Margin="0,2,0,10" />
                    <ListView ItemsSource="{Binding ValidationIssues}" Background="{StaticResource Brush.PanelAlt}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Height="164" SelectionMode="Single" MouseDoubleClick="ValidationIssues_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ValidationIssue}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Severity}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:ValidationSeverity.Error}">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:ValidationSeverity.Info}">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="12,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding SuggestedFix}" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource Brush.PanelAlt}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="14,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Editor Notes" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Middle mouse pans. Mouse wheel zooms. Left-click selects. Drag authored objects to reposition them on the grid." Margin="0,6,0,10" TextWrapping="Wrap" Foreground="{StaticResource Brush.Muted}" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Asset Palette" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Author common encounter pieces and keep designers inside one fast loop." Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />

                        <Button Content="Add Encounter Zone" Command="{Binding AddZoneCommand}" />
                        <Button Content="Add Spawn Point" Command="{Binding AddSpawnCommand}" />
                        <Button Content="Add Patrol Route" Command="{Binding AddPatrolRouteCommand}" />
                        <Button Content="Delete Selected" Command="{Binding DeleteSelectionCommand}" />
                        <Button Content="Undo" Command="{Binding UndoCommand}" />
                        <Button Content="Redo" Command="{Binding RedoCommand}" />

                        <Separator Margin="0,10,0,16" />

                        <TextBlock Text="Project Outline" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Use the outline to hop between authored objects quickly." Foreground="{StaticResource Brush.Muted}" Margin="0,4,0,12" />

                        <Expander Header="Zones" IsExpanded="True" Background="{StaticResource Brush.PanelAlt}" Margin="0,0,0,10">
                            <ListBox ItemsSource="{Binding Zones}" Background="Transparent" BorderThickness="0" MouseDoubleClick="Outline_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:EncounterZoneViewModel}">
                                        <Border Background="{Binding SecondaryBrush}" CornerRadius="6" Padding="10" Margin="0,4,0,4" Opacity="0.95">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" Foreground="#DBEAFE" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <Expander Header="Spawn Points" IsExpanded="True" Background="{StaticResource Brush.PanelAlt}" Margin="0,0,0,10">
                            <ListBox ItemsSource="{Binding SpawnPoints}" Background="Transparent" BorderThickness="0" MouseDoubleClick="Outline_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:SpawnPointViewModel}">
                                        <Border Background="#223145" CornerRadius="6" Padding="10" Margin="0,4,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" Foreground="#BFDBFE" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <Expander Header="Patrol Routes" IsExpanded="True" Background="{StaticResource Brush.PanelAlt}">
                            <ListBox ItemsSource="{Binding PatrolRoutes}" Background="Transparent" BorderThickness="0" MouseDoubleClick="Outline_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:PatrolRouteViewModel}">
                                        <Border Background="#312340" CornerRadius="6" Padding="10" Margin="0,4,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PointsSummary}" Foreground="#E9D5FF" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Encounter Canvas" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Top-down authored space with grid snapping, drag placement, and immediate validation feedback." Foreground="{StaticResource Brush.Muted}" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="{StaticResource Brush.PanelAlt}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ValidationSummary}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Name="ViewportHost"
                            Background="{StaticResource Brush.Canvas}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True"
                            MouseWheel="ViewportHost_MouseWheel"
                            MouseMove="ViewportHost_MouseMove"
                            MouseDown="ViewportHost_MouseDown"
                            MouseUp="ViewportHost_MouseUp">
                        <Canvas Name="SceneSurface"
                                Width="{Binding MapWidth}"
                                Height="{Binding MapHeight}"
                                Background="{StaticResource GridBrush}">
                            <Rectangle Width="{Binding MapWidth}" Height="{Binding MapHeight}" Fill="Transparent" MouseLeftButtonDown="SceneBackground_MouseLeftButtonDown" />

                            <ItemsControl ItemsSource="{Binding PatrolRoutes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0" />
                                        <Setter Property="Canvas.Top" Value="0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:PatrolRouteViewModel}">
                                        <Canvas>
                                            <Polyline Points="{Binding PolylinePoints}"
                                                      Stroke="{Binding SecondaryBrush}"
                                                      StrokeThickness="4"
                                                      StrokeLineJoin="Round"
                                                      MouseLeftButtonDown="Route_MouseLeftButtonDown" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{Binding SecondaryBrush}"
                                                       FontWeight="Bold"
                                                       Background="#B3121820"
                                                       Padding="6,2"
                                                       MouseLeftButtonDown="Route_MouseLeftButtonDown"
                                                       Canvas.Left="{Binding LabelX}"
                                                       Canvas.Top="{Binding LabelY}" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Zones}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:EncounterZoneViewModel}">
                                        <Border Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                Background="{Binding PrimaryBrush}"
                                                BorderBrush="{Binding SecondaryBrush}"
                                                BorderThickness="2"
                                                CornerRadius="10"
                                                MouseLeftButtonDown="Zone_MouseLeftButtonDown">
                                            <StackPanel Margin="12">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Brush.Muted}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding SpawnPoints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:SpawnPointViewModel}">
                                        <Grid MouseLeftButtonDown="Spawn_MouseLeftButtonDown">
                                            <Ellipse Width="18" Height="18" Fill="{Binding PrimaryBrush}" Stroke="{Binding SecondaryBrush}" StrokeThickness="2" />
                                            <Border Background="#CC11161D" CornerRadius="6" Padding="6,2" Margin="20,-4,0,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Inspector" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Author object details without leaving the canvas flow." Foreground="{StaticResource Brush.Muted}" Margin="0,4,0,12" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock Text="Select a zone, spawn point, or patrol route to inspect and edit it here."
                                       Foreground="{StaticResource Brush.Muted}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ContentControl Content="{Binding SelectedObject}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>

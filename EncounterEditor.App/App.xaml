<Application x:Class="EncounterEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Brush.Window" Color="#11161D" />
        <SolidColorBrush x:Key="Brush.Panel" Color="#18212B" />
        <SolidColorBrush x:Key="Brush.PanelAlt" Color="#1E2834" />
        <SolidColorBrush x:Key="Brush.Border" Color="#2C3A49" />
        <SolidColorBrush x:Key="Brush.Text" Color="#F1F5F9" />
        <SolidColorBrush x:Key="Brush.Muted" Color="#9FB2C6" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#49C7B1" />
        <SolidColorBrush x:Key="Brush.Warning" Color="#F7B955" />
        <SolidColorBrush x:Key="Brush.Error" Color="#F07178" />
        <SolidColorBrush x:Key="Brush.Canvas" Color="#0D1318" />

        <DrawingBrush x:Key="GridBrush"
                      Viewport="0,0,40,40"
                      ViewportUnits="Absolute"
                      TileMode="Tile"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#101820">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,40,40" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#22303D" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                                <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource Brush.Window}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </Application.Resources>
</Application>
